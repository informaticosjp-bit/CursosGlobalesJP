@{
    ViewData["Title"] = "Contacto y Atención | Cursos Globales JP";
    var courses = ViewBag.Courses as List<string> ?? new List<string>();
}

<!-- Encabezado / Hero de Contacto -->
<section class="py-5 text-white" style="background: linear-gradient(135deg, #0b1c36 0%, #153e75 100%);">
    <div class="container py-2 text-center">
        <span class="badge bg-warning text-dark px-3 py-1.5 fw-bold text-uppercase mb-3 shadow-xs">
            <i class="bi bi-headset me-1"></i> Centro de Atención y Soporte
        </span>
        <h1 class="display-5 fw-extrabold mb-3">Contacto y Consultas</h1>
        <p class="lead opacity-90 mx-auto mb-0" style="max-width: 680px; font-size: 1.15rem;">
            ¿Tienes preguntas sobre el catálogo de cursos, la emisión de certificados oficiales a $1 USD o la membresía para docentes? Escríbenos y con gusto te atenderemos.
        </p>
    </div>
</section>

<!-- Sección Principal: Datos de Contacto y Formulario Asíncrono -->
<section class="py-5" style="background-color: var(--cgjp-bg-light);">
    <div class="container">
        <div class="row g-4 justify-content-center">
            
            <!-- Columna Izquierda: Información de Contacto y Respaldo Legal -->
            <div class="col-lg-5">
                <div class="card border-0 shadow-sm rounded-4 p-4 h-100 bg-white">
                    <h4 class="fw-bold text-dark mb-3 d-flex align-items-center gap-2">
                        <i class="bi bi-building-check text-primary"></i> Canales de Atención
                    </h4>
                    <p class="text-muted small mb-4">
                        Estamos comprometidos con brindarte soporte ágil, transparente y personalizado en todo tu proceso de formación.
                    </p>

                    <!-- Canal WhatsApp -->
                    <div class="d-flex align-items-start gap-3 p-3 rounded-3 bg-light border mb-3">
                        <div class="rounded-circle bg-success bg-opacity-10 text-success p-2.5 d-flex align-items-center justify-content-center flex-shrink-0" style="width: 44px; height: 44px;">
                            <i class="bi bi-whatsapp fs-5"></i>
                        </div>
                        <div class="flex-grow-1">
                            <span class="d-block fw-bold text-dark">Atención Directa por WhatsApp</span>
                            <span class="d-block text-muted small mb-2">Respuesta rápida para dudas sobre inscripciones y pagos.</span>
                            <a href="https://api.whatsapp.com/send?text=Hola%20Cursos%20Globales%20JP,%20tengo%20una%20consulta%20sobre%20la%20plataforma%20educativa." 
                               target="_blank" rel="noopener noreferrer" 
                               class="btn btn-sm btn-success fw-bold px-3 py-1.5 rounded-pill shadow-xs">
                                <i class="bi bi-chat-dots-fill me-1"></i> Iniciar Chat de WhatsApp
                            </a>
                        </div>
                    </div>

                    <!-- Canal Correo Electrónico -->
                    <div class="d-flex align-items-start gap-3 p-3 rounded-3 bg-light border mb-3">
                        <div class="rounded-circle bg-primary bg-opacity-10 text-primary p-2.5 d-flex align-items-center justify-content-center flex-shrink-0" style="width: 44px; height: 44px;">
                            <i class="bi bi-envelope-check-fill fs-5"></i>
                        </div>
                        <div class="flex-grow-1">
                            <span class="d-block fw-bold text-dark">Correo Electrónico Oficial</span>
                            <a href="mailto:contacto@globalesjp.net" class="fw-semibold text-primary text-decoration-none small d-block">
                                contacto@globalesjp.net
                            </a>
                            <span class="text-muted small">Canal directo para soporte técnico, alianzas y validaciones.</span>
                        </div>
                    </div>

                    <!-- Canal Horarios y Respaldo Legal -->
                    <div class="d-flex align-items-start gap-3 p-3 rounded-3 bg-light border mb-4">
                        <div class="rounded-circle bg-warning bg-opacity-15 text-warning-emphasis p-2.5 d-flex align-items-center justify-content-center flex-shrink-0" style="width: 44px; height: 44px;">
                            <i class="bi bi-shield-check fs-5"></i>
                        </div>
                        <div class="flex-grow-1">
                            <span class="d-block fw-bold text-dark">Empresa Responsable</span>
                            <span class="d-block text-secondary small fw-semibold">Inversiones Globales JP 1968, C.A.</span>
                            <span class="d-block text-muted small">RIF: J-41102463-5 &bull; Horario: Lun a Sáb (8:00 AM - 7:00 PM)</span>
                        </div>
                    </div>

                    <!-- Puntos Clave de la Plataforma -->
                    <div class="border-top pt-3 mt-auto">
                        <h6 class="fw-bold text-dark mb-2 small text-uppercase" style="letter-spacing: 0.5px;">Garantías de Formación:</h6>
                        <ul class="list-unstyled small text-muted mb-0 d-flex flex-column gap-1.5">
                            <li><i class="bi bi-check-circle-fill text-success me-1.5"></i> Cursos con lecturas, presentaciones y temarios 100% libres.</li>
                            <li><i class="bi bi-check-circle-fill text-success me-1.5"></i> Certificación oficial verificable con Código QR por $1 USD.</li>
                            <li><i class="bi bi-check-circle-fill text-success me-1.5"></i> Pagos en bolívares calculados a la tasa oficial del BCV.</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Columna Derecha: Formulario Asíncrono AJAX (FormSubmit) -->
            <div class="col-lg-7">
                <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white position-relative overflow-hidden" id="contactCardContainer">
                    
                    <!-- Formulario de Contacto -->
                    <form id="contactForm" novalidate>
                        
                        <!-- Contenedor de Campos del Formulario -->
                        <div id="contactFormFields">
                            <div class="mb-4">
                                <h3 class="fw-bold text-dark mb-1">Envíanos tu Mensaje</h3>
                                <p class="text-muted small">
                                    Diligencia tus datos a continuación y nos comunicaremos contigo a la mayor brevedad.
                                </p>
                            </div>

                            <!-- Alerta de Error Dinámica -->
                            <div id="contactErrorAlert" class="alert alert-danger alert-dismissible fade show d-none border-0 shadow-xs mb-3" role="alert">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                <span id="contactErrorText">Hubo un problema al enviar tu consulta. Por favor intenta de nuevo.</span>
                            </div>

                            <!-- Fila: Nombre y Correo -->
                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label for="contactNombre" class="form-label fw-bold text-dark small">
                                        Nombre Completo <span class="text-danger">*</span>
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light border-end-0 text-muted">
                                            <i class="bi bi-person-fill"></i>
                                        </span>
                                        <input type="text" class="form-control border-start-0 ps-0" id="contactNombre" name="nombre" placeholder="Ej: Juan Pérez" required>
                                    </div>
                                    <div class="invalid-feedback small">Por favor ingresa tu nombre completo.</div>
                                </div>
                                <div class="col-md-6">
                                    <label for="contactCorreo" class="form-label fw-bold text-dark small">
                                        Correo Electrónico <span class="text-danger">*</span>
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light border-end-0 text-muted">
                                            <i class="bi bi-envelope-fill"></i>
                                        </span>
                                        <input type="email" class="form-control border-start-0 ps-0" id="contactCorreo" name="correo" placeholder="correo@ejemplo.com" required>
                                    </div>
                                    <div class="invalid-feedback small">Ingresa un correo electrónico válido.</div>
                                </div>
                            </div>

                            <!-- Fila: Teléfono y Curso de Interés -->
                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label for="contactTelefono" class="form-label fw-bold text-dark small">
                                        Teléfono / WhatsApp <span class="text-muted fw-normal">(Opcional)</span>
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light border-end-0 text-muted">
                                            <i class="bi bi-whatsapp"></i>
                                        </span>
                                        <input type="tel" class="form-control border-start-0 ps-0" id="contactTelefono" name="telefono" placeholder="+58 412 1234567">
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <label for="contactCurso" class="form-label fw-bold text-dark small">
                                        Curso de Interés <span class="text-muted fw-normal">(Opcional)</span>
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light border-end-0 text-muted">
                                            <i class="bi bi-journal-bookmark-fill"></i>
                                        </span>
                                        <select class="form-select border-start-0 ps-0" id="contactCurso" name="curso">
                                            <option value="Consulta General">-- Consulta General / Información --</option>
                                            <option value="Emisión de Certificado ($1 USD)">Emisión de Certificado ($1 USD)</option>
                                            <option value="Membresía Creador de Cursos ($10 USD)">Membresía Creador ($10 USD/año)</option>
                                            <option value="Generador de CV con IA ($1 USD)">Generador de CV con IA ($1 USD)</option>
                                            @if (courses != null && courses.Any())
                                            {
                                                <optgroup label="Cursos del Catálogo">
                                                    @foreach (var c in courses)
                                                    {
                                                        <option value="@c">@c</option>
                                                    }
                                                </optgroup>
                                            }
                                        </select>
                                    </div>
                                </div>
                            </div>

                            <!-- Campo: Mensaje / Duda -->
                            <div class="mb-4">
                                <label for="contactMensaje" class="form-label fw-bold text-dark small">
                                    Mensaje o Duda <span class="text-danger">*</span>
                                </label>
                                <textarea class="form-control" id="contactMensaje" name="mensaje" rows="4" 
                                          placeholder="Escribe aquí tu consulta o el detalle de lo que necesitas saber..." required></textarea>
                                <div class="invalid-feedback small">Por favor escribe tu mensaje o duda.</div>
                            </div>

                            <!-- Botón de Envío -->
                            <div class="d-grid mb-2">
                                <button type="submit" id="btnSubmitContact" class="btn btn-primary btn-lg fw-bold py-2.5 shadow-sm">
                                    <i class="bi bi-send-fill me-2"></i> Enviar Mensaje
                                </button>
                            </div>
                            <span class="text-muted text-center d-block small" style="font-size: 0.76rem;">
                                <i class="bi bi-lock-fill text-success me-1"></i> Tus datos están protegidos. Respuesta garantizada por correo o WhatsApp.
                            </span>
                        </div>
                    </form>

                    <!-- Mensaje Visual de Éxito (Reemplaza los campos en el MISMO lugar) -->
                    <div id="contactSuccessCard" class="text-center py-5 d-none animate__animated animate__fadeIn">
                        <div class="mb-3">
                            <span class="d-inline-flex align-items-center justify-content-center bg-success bg-opacity-15 text-success rounded-circle shadow-sm" style="width: 76px; height: 76px;">
                                <i class="bi bi-check2-circle fs-1 fw-bold"></i>
                            </span>
                        </div>
                        <h3 class="fw-extrabold text-dark mb-2">✅ ¡Solicitud Enviada!</h3>
                        <p class="text-muted fs-6 mb-4 mx-auto px-lg-3" style="max-width: 500px;">
                            Hemos recibido tu mensaje correctamente. Nuestro equipo se pondrá en contacto contigo a la brevedad.
                        </p>
                        
                        <div class="d-flex flex-wrap gap-2 justify-content-center pt-2">
                            <button type="button" id="btnResetContactForm" class="btn btn-outline-primary px-4 py-2 fw-semibold rounded-pill">
                                <i class="bi bi-arrow-repeat me-1.5"></i> Enviar otra consulta
                            </button>
                            <a href="https://api.whatsapp.com/send?text=Hola%20Cursos%20Globales%20JP,%20acabo%20de%20enviar%20una%20consulta%20desde%20la%20web%20y%20deseo%20atenci%C3%B3n." 
                               target="_blank" rel="noopener noreferrer" 
                               class="btn btn-success px-4 py-2 fw-semibold rounded-pill shadow-xs">
                                <i class="bi bi-whatsapp me-1.5"></i> Escribir por WhatsApp
                            </a>
                        </div>
                    </div>

                </div>
            </div>

        </div>
    </div>
</section>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const contactForm = document.getElementById("contactForm");
            const contactFormFields = document.getElementById("contactFormFields");
            const contactSuccessCard = document.getElementById("contactSuccessCard");
            const contactErrorAlert = document.getElementById("contactErrorAlert");
            const contactErrorText = document.getElementById("contactErrorText");
            const btnSubmit = document.getElementById("btnSubmitContact");
            const btnReset = document.getElementById("btnResetContactForm");

            if (!contactForm) return;

            contactForm.addEventListener("submit", async function (e) {
                e.preventDefault();

                // Validación nativa de formulario HTML5
                if (!contactForm.checkValidity()) {
                    contactForm.classList.add("was-validated");
                    return;
                }

                const nombre = document.getElementById("contactNombre").value.trim();
                const correo = document.getElementById("contactCorreo").value.trim();
                const telefono = document.getElementById("contactTelefono") ? document.getElementById("contactTelefono").value.trim() : "";
                const curso = document.getElementById("contactCurso") ? document.getElementById("contactCurso").value : "Consulta General";
                const mensaje = document.getElementById("contactMensaje").value.trim();

                if (!nombre || !correo || !mensaje) {
                    contactForm.classList.add("was-validated");
                    return;
                }

                // Estado de carga en el botón
                btnSubmit.disabled = true;
                const originalHtml = btnSubmit.innerHTML;
                btnSubmit.innerHTML = `<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span> Enviando...`;
                if (contactErrorAlert) contactErrorAlert.classList.add("d-none");

                // Payload JSON estructurado para FormSubmit (HTTPS puerto 443)
                const payload = {
                    "_subject": `[CURSOS GLOBALES JP] Nueva Consulta / Inscripción - ${nombre}`,
                    "_replyto": correo,
                    "_captcha": "false",
                    "_template": "table",
                    "Nombre Completo": nombre,
                    "Correo Electrónico": correo,
                    "Teléfono / WhatsApp": telefono || "No especificado",
                    "Curso de Interés": curso || "Consulta General",
                    "Mensaje / Duda": mensaje
                };

                try {
                    const response = await fetch("https://formsubmit.co/ajax/informaticosjp@gmail.com", {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json",
                            "Accept": "application/json"
                        },
                        body: JSON.stringify(payload)
                    });

                    if (response.ok) {
                        // Éxito: Ocultar los campos y mostrar el mensaje en el MISMO lugar
                        contactFormFields.classList.add("d-none");
                        contactSuccessCard.classList.remove("d-none");
                        contactForm.reset();
                        contactForm.classList.remove("was-validated");
                    } else {
                        const errorData = await response.json().catch(() => ({}));
                        throw new Error(errorData.message || "Error al procesar la solicitud en el servidor.");
                    }
                } catch (err) {
                    console.error("Error en FormSubmit:", err);
                    if (contactErrorAlert) {
                        if (contactErrorText) {
                            contactErrorText.textContent = "Ocurrió un error al enviar el mensaje. Por favor verifica tu conexión o escríbenos directamente por WhatsApp.";
                        }
                        contactErrorAlert.classList.remove("d-none");
                    }
                } finally {
                    btnSubmit.disabled = false;
                    btnSubmit.innerHTML = originalHtml;
                }
            });

            // Botón de Enviar otra consulta: restablece los campos y vuelve a mostrar el formulario
            if (btnReset) {
                btnReset.addEventListener("click", function () {
                    contactForm.reset();
                    contactForm.classList.remove("was-validated");
                    if (contactErrorAlert) contactErrorAlert.classList.add("d-none");
                    contactSuccessCard.classList.add("d-none");
                    contactFormFields.classList.remove("d-none");
                });
            }
        });
    </script>
}
