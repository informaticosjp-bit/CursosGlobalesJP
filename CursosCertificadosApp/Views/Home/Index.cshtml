@model List<CursosCertificadosApp.Models.Entities.Category>
@{
    ViewData["Title"] = "Educación Digital y Certificaciones Oficiales a $1 USD";
}

<!-- Hero Section -->
<section class="py-5 text-white" style="background: linear-gradient(135deg, #0b1c36 0%, #153e75 100%);">
    <div class="container py-4">
        <div class="row align-items-center g-5">
            <div class="col-lg-7">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <img src="~/images/logo-jp.png" alt="Logo Cursos Globales JP" class="rounded-circle shadow" style="width: 52px; height: 52px; object-fit: cover; border: 2px solid #ffffff;" />
                    <div>
                        <span class="badge bg-danger text-white px-3 py-1 fw-bold text-uppercase d-inline-block">CURSOS GLOBALES JP</span>
                        <span class="d-block small text-light opacity-90 fw-semibold">Aprende Gratis · Certifícate desde $1 USD</span>
                    </div>
                </div>
                <h1 class="display-4 fw-extrabold mb-3 lh-sm">
                    Aprende <span class="text-warning">100% Gratis</span>.<br />
                    Certifícate desde solo <span class="text-success bg-white px-2 py-0 rounded text-nowrap">$1 USD</span>.
                </h1>
                <p class="lead mb-4 text-light opacity-90">
                    Domina las habilidades más demandadas en Inteligencia Artificial, Análisis de Datos, Gerencia Ágil y Productividad. Sin suscripciones costosas ni letras pequeñas.
                </p>
                <div class="d-flex flex-wrap gap-3">
                    <a asp-controller="Cursos" asp-action="Index" class="btn btn-gold btn-lg px-4 py-3 fw-bold">
                        <i class="bi bi-play-circle-fill me-2"></i> Explorar Catálogo Gratuito
                    </a>
                    @if (User.Identity?.IsAuthenticated != true)
                    {
                        <a asp-controller="Account" asp-action="Register" class="btn btn-outline-light btn-lg px-4 py-3 fw-semibold">
                            Crear Cuenta Gratis
                        </a>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Dashboard" class="btn btn-outline-light btn-lg px-4 py-3 fw-semibold">
                            Ir a Mis Cursos
                        </a>
                    }
                </div>
                <div class="row mt-5 pt-3 border-top border-white border-opacity-10 text-center text-sm-start g-3">
                    <div class="col-sm-4">
                        <h4 class="fw-bold mb-0 text-warning">+@ViewBag.TotalCourses</h4>
                        <span class="small opacity-75">Cursos Disponibles</span>
                    </div>
                    <div class="col-sm-4">
                        <h4 class="fw-bold mb-0 text-warning">+@ViewBag.TotalHours hrs</h4>
                        <span class="small opacity-75">Contenido Especializado</span>
                    </div>
                    <div class="col-sm-4">
                        <h4 class="fw-bold mb-0 text-success">$1.00 USD</h4>
                        <span class="small opacity-75">Por Certificado Acreditado</span>
                    </div>
                </div>
            </div>
            <div class="col-lg-5">
                <div class="card border-0 shadow-lg p-4 bg-white text-dark rounded-4">
                    <div class="text-center mb-3">
                        <img src="~/images/logo-jp.png" alt="Logo JP" class="rounded-circle shadow-sm mb-2" style="width: 58px; height: 58px; object-fit: cover;" />
                        <h5 class="fw-bold mb-1">Cursos Globales JP</h5>
                        <p class="text-muted small">Tu esfuerzo respaldado con acreditación oficial</p>
                    </div>
                    <ul class="list-unstyled d-flex flex-column gap-3 mb-4">
                        <li class="d-flex align-items-start gap-3">
                            <i class="bi bi-check-circle-fill text-success fs-5 mt-1"></i>
                            <div>
                                <strong class="d-block">1. Lecturas y Guías Prácticas 100% Libres</strong>
                                <span class="text-muted small">Estudia material estructurado, presentaciones y contenido teórico verificado sin restricciones.</span>
                            </div>
                        </li>
                        <li class="d-flex align-items-start gap-3">
                            <i class="bi bi-check-circle-fill text-success fs-5 mt-1"></i>
                            <div>
                                <strong class="d-block">2. Evaluación Corta de Validación</strong>
                                <span class="text-muted small">Demuestra tu aprendizaje con una prueba sumativa de opción múltiple (mínimo 70%).</span>
                            </div>
                        </li>
                        <li class="d-flex align-items-start gap-3">
                            <i class="bi bi-check-circle-fill text-success fs-5 mt-1"></i>
                            <div>
                                <strong class="d-block">3. Certificación Oficial desde $1 USD</strong>
                                <span class="text-muted small">Al aprobar la prueba, emite tu diploma con código QR único para tu perfil de LinkedIn.</span>
                            </div>
                        </li>
                    </ul>
                    <a asp-controller="Cursos" asp-action="Index" class="btn btn-brand w-100 py-2">
                        Comenzar Ahora Mismo
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Rutas Formativas / Categorías -->
<section class="py-5 bg-white">
    <div class="container py-3">
        <div class="text-center max-w-700 mx-auto mb-5">
            <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 fw-semibold text-uppercase">
                Rutas Formativas
            </span>
            <h2 class="fw-bold mt-2">Impulsa tu Perfil Profesional por Especialidad</h2>
            <p class="text-muted">Selecciona una ruta estructurada de aprendizaje para dominar las competencias del mercado laboral actual.</p>
        </div>

        <div class="row g-4">
            @foreach (var cat in Model.Where(c => c.Courses != null && c.Courses.Count > 0))
            {
                <div class="col-md-6 col-lg-3">
                    <div class="card h-100 border-0 shadow-sm rounded-4 p-4 text-center d-flex flex-column">
                        <div class="mb-3 mx-auto p-3 rounded-circle bg-light text-primary fs-2">
                            <i class="bi @cat.IconClass"></i>
                        </div>
                        <h5 class="fw-bold mb-2">@cat.Name</h5>
                        <p class="text-muted small flex-grow-1 mb-3">@cat.Description</p>
                        <a href="/Cursos?categoria=@cat.Slug" class="btn btn-outline-primary btn-sm rounded-pill fw-semibold mt-auto">
                            Ver @cat.Courses.Count Cursos <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- Catálogo Destacado -->
<section class="py-5">
    <div class="container py-3">
        <div class="d-flex flex-wrap justify-content-between align-items-end mb-4">
            <div>
                <h3 class="fw-bold mb-1">Cursos Más Demandados</h3>
                <p class="text-muted mb-0">Comienza a capacitarte hoy sin costo alguno.</p>
            </div>
            <a asp-controller="Cursos" asp-action="Index" class="btn btn-link text-primary fw-bold text-decoration-none">
                Ver todos los cursos (@ViewBag.TotalCourses) <i class="bi bi-arrow-right"></i>
            </a>
        </div>

        @{
            var featuredList = (ViewBag.FeaturedCourses as List<CursosCertificadosApp.Models.Entities.Course>) 
                               ?? Model.SelectMany(c => c.Courses).ToList();

            // Regla de cuadros perfectos: Truncar siempre a un múltiplo de 3 para que nunca quede un cuadro suelto ni espacios vacíos
            int countFeatured = featuredList.Count;
            int perfectRowsCount = (countFeatured / 3) * 3;
            var coursesToDisplay = featuredList.Take(perfectRowsCount).ToList();
        }

        <div class="row g-4">
            @foreach (var course in coursesToDisplay)
            {
                var categoryName = course.Category?.Name ?? "General";
                <div class="col-md-6 col-lg-4">
                    <div class="card card-course h-100 shadow-sm d-flex flex-column">
                        <div class="p-4 flex-grow-1 d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="badge bg-primary bg-opacity-10 text-primary fw-bold text-truncate" style="max-width: 65%;">@categoryName</span>
                                <span class="badge bg-light text-dark border">
                                    <i class="bi bi-clock me-1"></i> @course.EstimatedHours hrs
                                </span>
                            </div>
                            <h5 class="fw-bold mt-2 mb-2">
                                <a asp-controller="Cursos" asp-action="Detalle" asp-route-slug="@course.Slug" class="text-decoration-none text-dark">
                                    @course.Title
                                </a>
                            </h5>
                            <p class="text-muted small mb-3 flex-grow-1">
                                @course.ShortDescription
                            </p>
                            <div class="d-flex flex-wrap gap-2 align-items-center mt-auto">
                                <span class="badge bg-info bg-opacity-10 text-info fw-semibold">
                                    <i class="bi bi-bar-chart-steps me-1"></i>@course.Level
                                </span>
                                <span class="badge bg-light text-secondary border small">
                                    <i class="bi bi-journal-text me-1"></i>@(course.Modules?.Count ?? 0) Módulos
                                </span>
                            </div>
                        </div>
                        <div class="border-top px-3 py-2.5 bg-light d-flex justify-content-between align-items-center gap-2">
                            <div class="d-flex align-items-center gap-1 gap-sm-2 text-nowrap" style="white-space: nowrap;">
                                <span class="badge bg-success bg-opacity-10 text-success fw-bold">Gratis</span>
                                <span class="text-muted small fw-semibold">Cert: $@course.Price.ToString("F2") USD</span>
                            </div>
                            <a asp-controller="Cursos" asp-action="Detalle" asp-route-slug="@course.Slug" class="btn btn-sm btn-brand text-nowrap flex-shrink-0" style="white-space: nowrap;">
                                Ver Temario <i class="bi bi-chevron-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- Banner de Verificación y Respaldo -->
<section class="py-5 bg-white border-top">
    <div class="container text-center py-4">
        <div class="max-w-700 mx-auto">
            <i class="bi bi-award-fill text-warning fs-1 mb-3 d-inline-block"></i>
            <h2 class="fw-bold mb-3">¿Eres Empleador o Reclutador de RRHH?</h2>
            <p class="text-muted mb-4">
                Todos nuestros certificados cuentan con un código de verificación criptográfico único y un código QR dinámico para constatar la autenticidad e identidad del egresado en segundos.
            </p>
            <div class="row justify-content-center">
                <div class="col-md-6">
                    <form asp-controller="Certificados" asp-action="Verificar" method="get" class="input-group mb-3">
                        <input type="text" name="id" class="form-control" placeholder="Ej: CGJP-2026-X89K2" required>
                        <button class="btn btn-primary fw-bold px-4" type="submit">
                            <i class="bi bi-search me-1"></i> Validar
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Anuncio Oficial: Conviértete en Creador de Cursos ($10 USD / Gana $1 por venta) -->
<section class="py-5" style="background: linear-gradient(135deg, #0b1c36 0%, #173b75 100%);">
    <div class="container py-3">
        <div class="row align-items-center g-4 text-white">
            <div class="col-lg-8">
                <span class="badge bg-warning text-dark px-3 py-1 fw-bold mb-3">
                    <i class="bi bi-star-fill me-1"></i> PROGRAMA PARA DOCENTES Y EXPERTOS
                </span>
                <h2 class="display-6 fw-extrabold mb-3">¿Deseas Impartir tus Propios Cursos?</h2>
                <p class="lead opacity-90 mb-3" style="font-size: 1.1rem;">
                    Regístrate como <strong>Creador Oficial de Cursos Globales JP</strong> por una membresía anual de solo <strong>$10 USD</strong> (calculados a tasa oficial BCV). Accede al editor interactivo para estructurar tus temarios, subir imágenes e incrustar videos de YouTube.
                </p>
                <div class="d-flex flex-wrap gap-4 small text-light mb-4">
                    <div><i class="bi bi-cash-coin text-warning fs-5 me-1"></i> Gana <strong>$1.00 USD</strong> por cada certificado oficial emitido.</div>
                    <div><i class="bi bi-palette text-warning fs-5 me-1"></i> Panel exclusivo 'Modo Creador' para administrar tus formaciones.</div>
                    <div><i class="bi bi-infinity text-warning fs-5 me-1"></i> Publica cursos sin límites anuales.</div>
                </div>
                <a asp-controller="Membresia" asp-action="Creador" class="btn btn-warning text-dark btn-lg fw-bold px-4 py-3 shadow">
                    <i class="bi bi-palette-fill me-2"></i> Activar Membresía de Creador ($10 USD/año)
                </a>
            </div>
            <div class="col-lg-4 text-center">
                <div class="p-4 rounded-4 bg-white bg-opacity-10 backdrop-blur border border-white border-opacity-25 shadow-sm text-center">
                    <div class="rounded-circle bg-warning bg-opacity-20 text-warning d-inline-flex p-3 mb-3">
                        <i class="bi bi-award-fill fs-1"></i>
                    </div>
                    <h4 class="fw-bold text-white mb-1">Membresía Creador</h4>
                    <span class="badge bg-warning text-dark fw-bold mb-3">$10 USD Anuales</span>
                    <p class="small text-light opacity-75 mb-3">
                        Tarifa fija por el uso de la plataforma. Pagos en Bolívares a la tasa oficial del Banco Central de Venezuela.
                    </p>
                    <a asp-controller="Membresia" asp-action="Creador" class="btn btn-outline-light w-100 fw-bold">
                        Ver Detalles y Registrarse
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
