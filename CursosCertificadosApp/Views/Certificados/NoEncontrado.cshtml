@{
    ViewData["Title"] = "Certificado No Encontrado";
}

<div class="container py-5 text-center">
    <div class="max-w-500 mx-auto py-5">
        <i class="bi bi-shield-x display-1 text-danger mb-3 d-inline-block"></i>
        <h2 class="fw-bold mb-2">Código de Verificación No Encontrado</h2>
        <p class="text-muted">
            El código <code>@ViewBag.NotFoundCode</code> no corresponde a ningún certificado emitido por Cursos Globales JP o aún no ha sido registrado.
        </p>

        <form asp-action="Verificar" method="get" class="input-group my-4">
            <input type="text" name="id" class="form-control" placeholder="Ingresa otro código (ej: CGJP-2026-X89K2)" required />
            <button class="btn btn-primary" type="submit">Reintentar</button>
        </form>

        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-sm">Volver al Inicio</a>
    </div>
</div>
