@model CursosCertificadosApp.Services.CourseStudySessionViewModel
@{
    ViewData["Title"] = $"Evaluación Final - {Model.Course.Title}";
    var quiz = Model.Quiz;
}

<div class="container py-4">
    <!-- Breadcrumb de Regreso -->
    <div class="mb-3">
        <a asp-action="Aula" asp-route-slug="@Model.Course.Slug" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Volver a las Lecturas
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-9">
            <!-- Header de la Evaluación -->
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 mb-4 text-white" style="background: linear-gradient(135deg, #0b1c36 0%, #153e75 100%);">
                <span class="badge bg-warning text-dark px-3 py-1 fw-bold mb-2 d-inline-block text-uppercase">
                    <i class="bi bi-patch-question-fill me-1"></i> Evaluación Sumativa de Conocimientos
                </span>
                <h1 class="display-6 fw-bold mb-2">@quiz?.Title</h1>
                <p class="lead opacity-90 mb-3">@quiz?.Description</p>

                <div class="d-flex flex-wrap gap-4 text-light small">
                    <div><i class="bi bi-check-circle-fill text-success me-1"></i> Aprobación Mínima: <strong>@quiz?.PassingPercentage.ToString("F0")%</strong></div>
                    <div><i class="bi bi-clock-history text-warning me-1"></i> Tiempo sugerido: <strong>@quiz?.TimeLimitMinutes minutos</strong></div>
                    <div><i class="bi bi-award-fill text-warning me-1"></i> Desbloquea Certificado Oficial ($1 USD)</div>
                </div>
            </div>

            @if (Model.Enrollment.QuizPassed)
            {
                <!-- Estado: Ya Aprobado -->
                <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white mb-4">
                    <div class="badge bg-success bg-opacity-10 text-success p-3 rounded-circle mb-3 d-inline-block">
                        <i class="bi bi-trophy-fill display-3 text-success"></i>
                    </div>
                    <h2 class="fw-bold text-success mb-2">¡Evaluación Aprobada con Éxito!</h2>
                    <p class="text-muted mb-4">
                        Obtuviste una calificación de <strong>@Model.Enrollment.QuizScore.ToString("F0")%</strong>. Tu certificado oficial de <strong>@Model.Course.Title</strong> ha sido generado en el sistema y se encuentra listo para su liberación y descarga.
                    </p>

                    @if (Model.Certificate != null)
                    {
                        <a asp-controller="Certificados" asp-action="Completado" asp-route-id="@Model.Certificate.Id" class="btn btn-gold btn-lg fw-bold px-4 py-3 shadow">
                            <i class="bi bi-award-fill me-2"></i> Ir a Reclamar y Descargar Certificado ($1 USD)
                        </a>
                    }
                </div>
            }
            else
            {
                <!-- Formulario de Examen -->
                <form asp-action="RendirEvaluacion" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="quizId" value="@quiz?.Id" />
                    <input type="hidden" name="courseSlug" value="@Model.Course.Slug" />

                    @if (quiz?.Questions != null && quiz.Questions.Any())
                    {
                        int qNum = 1;
                        foreach (var q in quiz.Questions.OrderBy(qu => qu.OrderIndex))
                        {
                            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
                                <div class="d-flex align-items-start gap-3 mb-3">
                                    <span class="badge bg-primary text-white fs-6 rounded-circle p-2 px-3">@qNum</span>
                                    <h5 class="fw-bold mb-0 pt-1">@q.QuestionText</h5>
                                </div>

                                <div class="list-group list-group-flush ps-4">
                                    @foreach (var opt in q.Options)
                                    {
                                        <label class="list-group-item list-group-item-action d-flex align-items-center gap-3 py-3 border-0 rounded-3 mb-2 bg-light">
                                            <input class="form-check-input flex-shrink-0" type="radio" 
                                                   name="question_@q.Id" 
                                                   value="@opt.Id" 
                                                   required />
                                            <span class="small text-dark fw-medium">@opt.OptionText</span>
                                        </label>
                                    }
                                </div>
                            </div>
                            qNum++;
                        }

                        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white text-center">
                            <p class="small text-muted mb-3">
                                Al presionar el botón confirmas que has respondido a todas las preguntas con base en las lecturas del curso.
                            </p>
                            <button type="submit" class="btn btn-gold btn-lg fw-bold px-5 py-3 shadow">
                                <i class="bi bi-send-check-fill me-2"></i> Enviar Evaluación para Calificación
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info">No se encontraron preguntas configuradas para este curso.</div>
                    }
                </form>
            }
        </div>
    </div>
</div>
