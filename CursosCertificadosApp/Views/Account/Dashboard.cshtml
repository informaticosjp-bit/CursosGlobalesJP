@model List<CursosCertificadosApp.Models.Entities.CourseEnrollment>
@{
    ViewData["Title"] = "Panel de Estudiante - Mis Cursos";
    var user = ViewBag.User as CursosCertificadosApp.Models.Entities.User;
    var certificates = ViewBag.Certificates as List<CursosCertificadosApp.Models.Entities.Certificate> ?? new();
    var notifications = ViewBag.Notifications as List<CursosCertificadosApp.Models.Entities.UserNotification> ?? new();
    
    var completedCount = Model.Count(e => e.IsCompleted);
    var inProgressCount = Model.Count(e => !e.IsCompleted);
    var issuedCertificatesCount = certificates.Count(c => c.Status == CursosCertificadosApp.Models.Entities.CertificateStatus.Issued);
}

<div class="container py-4">
    <!-- Header de Perfil -->
    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 text-white" style="background: linear-gradient(135deg, #0f284e 0%, #1e3a8a 100%);">
        <div class="row align-items-center g-3">
            <div class="col-md-7 d-flex align-items-center gap-3">
                @if (!string.IsNullOrEmpty(user?.ProfilePictureUrl))
                {
                    <img src="@user.ProfilePictureUrl" alt="Foto de Perfil" 
                         class="rounded-circle shadow border border-3 border-white object-fit-cover" 
                         style="width: 65px; height: 65px; object-fit: cover;" />
                }
                else
                {
                    <div class="rounded-circle shadow border border-3 border-white d-flex align-items-center justify-content-center fw-bold fs-4 text-white" 
                         style="width: 65px; height: 65px; background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%);">
                        @user?.Initials
                    </div>
                }
                <div>
                    <div class="d-flex align-items-center gap-2">
                        <h3 class="fw-bold mb-0">@user?.FullName</h3>
                        @if (user?.Role == "Creator")
                        {
                            <span class="badge bg-warning text-dark fw-bold"><i class="bi bi-palette-fill me-1"></i> CREADOR OFICIAL</span>
                        }
                        else if (user?.Role == "Admin")
                        {
                            <span class="badge bg-danger fw-bold"><i class="bi bi-shield-lock-fill me-1"></i> ADMIN MASTER</span>
                        }
                    </div>
                    <p class="mb-0 text-light opacity-75 small mt-1">
                        <i class="bi bi-card-text me-1"></i> Documento: <strong>@user?.IdentificationNumber</strong> | 
                        <i class="bi bi-envelope me-1 ms-2"></i> @user?.Email
                    </p>
                </div>
            </div>
            <div class="col-md-5 text-md-end d-flex flex-wrap gap-2 justify-content-md-end">
                <a asp-controller="Account" asp-action="Perfil" class="btn btn-outline-light fw-semibold" title="Editar mi información personal, cédula, dirección y foto">
                    <i class="bi bi-pencil-square me-1"></i> Editar Perfil
                </a>
                @if (user?.Role == "Creator")
                {
                    <a asp-controller="Creador" asp-action="Cursos" class="btn btn-warning text-dark fw-bold">
                        <i class="bi bi-palette-fill me-1"></i> Mis Cursos como Creador
                    </a>
                }
                else if (user?.Role != "Admin")
                {
                    <a asp-controller="Membresia" asp-action="Creador" class="btn btn-warning text-dark fw-bold">
                        <i class="bi bi-star-fill me-1"></i> Membresía Creador ($10)
                    </a>
                }
                <a asp-controller="Cursos" asp-action="Index" class="btn btn-gold fw-bold">
                    <i class="bi bi-plus-circle me-1"></i> Inscribir Nuevo Curso
                </a>
            </div>
        </div>
    </div>

    <!-- Centro de Notificaciones y Mensajes -->
    @if (notifications.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-bell-fill text-warning me-2"></i>Centro de Notificaciones y Mensajes
                    @if (notifications.Any(n => !n.IsRead))
                    {
                        <span class="badge bg-danger rounded-pill ms-2" style="font-size: 0.75rem;">@notifications.Count(n => !n.IsRead) Nuevas</span>
                    }
                </h5>
            </div>
            <div class="list-group list-group-flush">
                @foreach (var notif in notifications)
                {
                    <div class="list-group-item px-3 py-3 rounded-3 mb-2 border @(!notif.IsRead ? "bg-light border-primary border-opacity-25" : "bg-white")">
                        <div class="d-flex w-100 justify-content-between align-items-center mb-1">
                            <h6 class="mb-1 fw-bold text-dark">
                                @if (notif.Type == "Success")
                                {
                                    <i class="bi bi-check-circle-fill text-success me-2"></i>
                                }
                                else if (notif.Type == "Warning")
                                {
                                    <i class="bi bi-exclamation-triangle-fill text-warning me-2"></i>
                                }
                                else
                                {
                                    <i class="bi bi-info-circle-fill text-primary me-2"></i>
                                }
                                @notif.Title
                            </h6>
                            <small class="text-muted">@notif.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small>
                        </div>
                        <p class="mb-2 small text-secondary">@notif.Message</p>
                        @if (notif.Title.Contains("Membresía") && notif.Type == "Success")
                        {
                            <a asp-controller="Creador" asp-action="Cursos" class="btn btn-warning btn-sm text-dark fw-bold">
                                <i class="bi bi-palette-fill me-1"></i> Ir al Panel de Modo Creador
                            </a>
                        }
                    </div>
                }
            </div>
        </div>
    }

    <!-- Métricas del Alumno -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white d-flex flex-row align-items-center gap-3">
                <div class="p-3 bg-primary bg-opacity-10 text-primary rounded-3 fs-3">
                    <i class="bi bi-book-half"></i>
                </div>
                <div>
                    <h4 class="fw-bold mb-0">@inProgressCount</h4>
                    <span class="text-muted small">Cursos en Progreso</span>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white d-flex flex-row align-items-center gap-3">
                <div class="p-3 bg-success bg-opacity-10 text-success rounded-3 fs-3">
                    <i class="bi bi-check2-circle"></i>
                </div>
                <div>
                    <h4 class="fw-bold mb-0">@completedCount</h4>
                    <span class="text-muted small">Cursos Culminados al 100%</span>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white d-flex flex-row align-items-center gap-3">
                <div class="p-3 bg-warning bg-opacity-10 text-warning rounded-3 fs-3">
                    <i class="bi bi-patch-check-fill"></i>
                </div>
                <div>
                    <h4 class="fw-bold mb-0">@issuedCertificatesCount</h4>
                    <span class="text-muted small">Certificados Oficiales Emitidos</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Cursos Inscritos -->
    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
        <h4 class="fw-bold mb-3 d-flex align-items-center gap-2">
            <i class="bi bi-journal-text text-primary"></i> Mi Avance Académico
        </h4>

        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-journal-x fs-1 text-muted mb-2 d-inline-block"></i>
                <h5 class="fw-bold text-muted">Aún no te has inscrito en ningún curso</h5>
                <p class="text-muted small">Todo nuestro catálogo es libre y sin costo de acceso.</p>
                <a asp-controller="Cursos" asp-action="Index" class="btn btn-brand">Explorar Catálogo</a>
            </div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var enrollment in Model)
                {
                    var cert = certificates.FirstOrDefault(c => c.CourseId == enrollment.CourseId);

                    <div class="col-md-6 col-lg-4">
                        <div class="card card-course h-100 shadow-sm p-3 d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="badge bg-primary bg-opacity-10 text-primary small">@enrollment.Course.Category.Name</span>
                                <span class="badge bg-light text-dark border small">@enrollment.Course.Level</span>
                            </div>

                            <h6 class="fw-bold mb-3">@enrollment.Course.Title</h6>

                            <div class="mt-auto">
                                <div class="d-flex justify-content-between small text-muted mb-1">
                                    <span>Progreso:</span>
                                    <span class="fw-bold text-dark">@enrollment.ProgressPercentage.ToString("F0")%</span>
                                </div>
                                <div class="progress mb-3" style="height: 8px;">
                                    <div class="progress-bar progress-bar-custom" role="progressbar" 
                                         style="width: @enrollment.ProgressPercentage%;" 
                                         aria-valuenow="@enrollment.ProgressPercentage" aria-valuemin="0" aria-valuemax="100">
                                    </div>
                                </div>

                                @if (enrollment.IsCompleted && cert != null)
                                {
                                    @if (cert.Status == CursosCertificadosApp.Models.Entities.CertificateStatus.Issued)
                                    {
                                        <a asp-controller="Certificados" asp-action="Descargar" asp-route-id="@cert.Id" class="btn btn-success btn-sm w-100 fw-bold">
                                            <i class="bi bi-file-earmark-pdf-fill me-1"></i> Descargar Diploma (PDF)
                                        </a>
                                    }
                                    else if (cert.Status == CursosCertificadosApp.Models.Entities.CertificateStatus.PendingPayment)
                                    {
                                        <a asp-controller="Certificados" asp-action="Completado" asp-route-id="@cert.Id" class="btn btn-warning text-dark btn-sm w-100 fw-bold">
                                            <i class="bi bi-clock-history me-1"></i> Solicitud en Revisión
                                        </a>
                                    }
                                    else
                                    {
                                        <a asp-controller="Certificados" asp-action="Completado" asp-route-id="@cert.Id" class="btn btn-gold btn-sm w-100 fw-bold shadow-sm">
                                            <i class="bi bi-award me-1"></i> Solicitar Certificado ($1 USD)
                                        </a>
                                    }
                                }
                                else
                                {
                                    <a asp-controller="Aula" asp-action="Aula" asp-route-slug="@enrollment.Course.Slug" class="btn btn-brand btn-sm w-100">
                                        <i class="bi bi-play-fill me-1"></i> Continuar Curso
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- Mis Certificados Oficiales -->
    @if (certificates.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
            <h4 class="fw-bold mb-3 d-flex align-items-center gap-2">
                <i class="bi bi-award-fill text-warning"></i> Mis Certificados y Diplomas
            </h4>
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Curso</th>
                            <th>Código de Validación</th>
                            <th>Estado</th>
                            <th>Fecha</th>
                            <th class="text-end">Acción</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in certificates)
                        {
                            <tr>
                                <td class="fw-bold">@c.Course.Title</td>
                                <td><code>@c.VerificationCode</code></td>
                                <td>
                                    @if (c.Status == CursosCertificadosApp.Models.Entities.CertificateStatus.Issued)
                                    {
                                        <span class="badge bg-success">Oficial Emitido</span>
                                    }
                                    else if (c.Status == CursosCertificadosApp.Models.Entities.CertificateStatus.PendingPayment)
                                    {
                                        <span class="badge bg-warning text-dark">Validando Pago ($1)</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Bloqueado (Pendiente $1)</span>
                                    }
                                </td>
                                <td>@(c.IssuedAt?.ToString("dd/MM/yyyy") ?? c.CreatedAt.ToString("dd/MM/yyyy"))</td>
                                <td class="text-end">
                                    @if (c.Status == CursosCertificadosApp.Models.Entities.CertificateStatus.Issued)
                                    {
                                        <a asp-controller="Certificados" asp-action="Descargar" asp-route-id="@c.Id" class="btn btn-sm btn-outline-success">
                                            <i class="bi bi-download"></i> PDF
                                        </a>
                                        <a asp-controller="Certificados" asp-action="Verificar" asp-route-id="@c.VerificationCode" target="_blank" class="btn btn-sm btn-outline-primary ms-1">
                                            <i class="bi bi-shield-check"></i> Validar
                                        </a>
                                    }
                                    else if (c.Status == CursosCertificadosApp.Models.Entities.CertificateStatus.PendingPayment)
                                    {
                                        <a asp-controller="Certificados" asp-action="Completado" asp-route-id="@c.Id" class="btn btn-sm btn-outline-warning text-dark">
                                            <i class="bi bi-clock-history me-1"></i> En Revisión
                                        </a>
                                    }
                                    else
                                    {
                                        <a asp-controller="Certificados" asp-action="Completado" asp-route-id="@c.Id" class="btn btn-sm btn-gold">
                                            <i class="bi bi-send-check me-1"></i> Solicitar Certificado
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
