@inject CursosCertificadosApp.Services.ISiteSettingService SiteSettingService
@{
    var siteConfig = await SiteSettingService.GetSettingsAsync();
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null && ViewData["Title"]!.ToString() == "GLOBALESJP.NET | CURSOS" 
            ? "GLOBALESJP.NET | CURSOS" 
            : (string.IsNullOrEmpty(ViewData["Title"]?.ToString()) 
                ? "GLOBALESJP.NET | CURSOS" 
                : $"{ViewData["Title"]} | GLOBALESJP.NET | CURSOS"))</title>
    
    <!-- Script Inmediato de Detección de Modo Oscuro (Claro Predeterminado) -->
    <script>
        (function () {
            try {
                var savedTheme = localStorage.getItem('cgjp_theme_mode');
                if (savedTheme !== 'dark' && savedTheme !== 'light') {
                    savedTheme = 'light';
                }
                document.documentElement.setAttribute('data-bs-theme', savedTheme);
                document.documentElement.setAttribute('data-theme', savedTheme);
            } catch (e) { }
        })();
    </script>
    
    <!-- Favicon Oficial -->
    <link rel="icon" type="image/png" href="@siteConfig.LogoUrl" />
    <link rel="apple-touch-icon" href="@siteConfig.LogoUrl" />
    
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Google Fonts: Inter / Outfit -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        :root {
            --cgjp-primary: #0f284e;
            --cgjp-secondary: #f59e0b;
            --cgjp-accent: #2563eb;
            --cgjp-bg-light: #f8fafc;
            --cgjp-red: #e11d48;
        }

        html, body {
            overflow-x: hidden;
            width: 100%;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: var(--cgjp-bg-light);
            color: #1e293b;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* Menú Lateral Móvil Fluido (Offcanvas) */
        .offcanvas-mobile {
            max-width: 86vw;
            width: 320px !important;
            border-left: 1px solid rgba(0,0,0,0.08);
            box-shadow: -8px 0 30px rgba(0, 0, 0, 0.12);
            transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1) !important;
        }

        @@media (max-width: 991.98px) {
            .offcanvas-mobile .nav-link {
                padding: 0.65rem 0.85rem !important;
                border-radius: 10px;
                font-size: 0.95rem;
                transition: all 0.15s ease-in-out;
            }
            .offcanvas-mobile .nav-link:hover,
            .offcanvas-mobile .nav-link:active {
                background-color: #f1f5f9;
                color: var(--cgjp-primary) !important;
            }
            .offcanvas-mobile .offcanvas-body {
                overflow-y: auto;
                overflow-x: hidden;
                -webkit-overflow-scrolling: touch;
            }
        }

        .navbar-brand-custom {
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .main-content {
            flex: 1;
        }

        .card-course {
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
            overflow: hidden;
            background: #ffffff;
        }

        .card-course:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 24px -10px rgba(15, 40, 78, 0.15);
        }

        .progress-bar-custom {
            background: linear-gradient(90deg, #2563eb 0%, #10b981 100%);
            border-radius: 10px;
        }

        .btn-brand {
            background-color: var(--cgjp-primary);
            color: #ffffff;
            font-weight: 600;
            border: none;
            padding: 9px 20px;
            border-radius: 8px;
            white-space: nowrap;
            transition: all 0.2s;
        }

        .btn-brand:hover {
            background-color: #1a3a6b;
            color: #ffffff;
        }

        .btn-gold {
            background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
            color: #ffffff;
            font-weight: 700;
            border: none;
            border-radius: 8px;
        }

        .btn-gold:hover {
            background: linear-gradient(135deg, #d97706 0%, #b45309 100%);
            color: #ffffff;
        }

        .footer-custom {
            background-color: #0b1c36;
            color: #94a3b8;
            padding: 40px 0 20px;
            margin-top: auto;
        }

        /* ==========================================================================
           MODO OSCURO - GLOBALESJP.NET STYLE
           ========================================================================== */
        [data-bs-theme="dark"] {
            --cgjp-primary: #3b82f6;
            --cgjp-secondary: #f59e0b;
            --cgjp-accent: #60a5fa;
            --cgjp-bg-light: #080e1e;
            --cgjp-red: #f43f5e;
        }

        [data-bs-theme="dark"] body {
            background-color: #080e1e !important;
            color: #e2e8f0 !important;
        }

        [data-bs-theme="dark"] header.sticky-top,
        [data-bs-theme="dark"] .bg-white {
            background-color: #0c1427 !important;
            color: #f1f5f9 !important;
        }

        [data-bs-theme="dark"] .bg-light {
            background-color: #0e1830 !important;
            color: #f1f5f9 !important;
        }

        [data-bs-theme="dark"] .navbar {
            background-color: #0c1427 !important;
        }

        [data-bs-theme="dark"] .navbar .nav-link {
            color: #cbd5e1 !important;
        }

        [data-bs-theme="dark"] .navbar .nav-link:hover {
            color: #38bdf8 !important;
        }

        [data-bs-theme="dark"] .offcanvas-mobile {
            background-color: #0c1427 !important;
            border-color: #1e293b !important;
            color: #f1f5f9 !important;
        }

        [data-bs-theme="dark"] .card-course,
        [data-bs-theme="dark"] .card {
            background-color: #0f1c36 !important;
            border-color: #1e293b !important;
            color: #f1f5f9 !important;
        }

        [data-bs-theme="dark"] .card-course:hover {
            box-shadow: 0 12px 28px -10px rgba(0, 0, 0, 0.6) !important;
        }

        [data-bs-theme="dark"] .text-dark {
            color: #f1f5f9 !important;
        }

        [data-bs-theme="dark"] .text-secondary,
        [data-bs-theme="dark"] .text-muted {
            color: #94a3b8 !important;
        }

        [data-bs-theme="dark"] .border,
        [data-bs-theme="dark"] .border-top,
        [data-bs-theme="dark"] .border-bottom,
        [data-bs-theme="dark"] .border-start,
        [data-bs-theme="dark"] .border-end {
            border-color: #1e293b !important;
        }

        [data-bs-theme="dark"] .dropdown-menu {
            background-color: #0f1c36 !important;
            border: 1px solid #1e293b !important;
            color: #f1f5f9 !important;
            box-shadow: 0 10px 30px rgba(0,0,0,0.6) !important;
        }

        [data-bs-theme="dark"] .dropdown-item {
            color: #e2e8f0 !important;
        }

        [data-bs-theme="dark"] .dropdown-item:hover {
            background-color: #1a2a4c !important;
            color: #38bdf8 !important;
        }

        [data-bs-theme="dark"] .dropdown-divider {
            border-color: #1e293b !important;
        }

        [data-bs-theme="dark"] .table {
            color: #f1f5f9 !important;
            border-color: #1e293b !important;
        }

        [data-bs-theme="dark"] .table-light,
        [data-bs-theme="dark"] thead th {
            background-color: #0b1329 !important;
            color: #cbd5e1 !important;
            border-color: #1e293b !important;
        }

        [data-bs-theme="dark"] .form-control,
        [data-bs-theme="dark"] .form-select {
            background-color: #0b1329 !important;
            border-color: #1e293b !important;
            color: #f1f5f9 !important;
        }

        [data-bs-theme="dark"] .form-control:focus,
        [data-bs-theme="dark"] .form-select:focus {
            background-color: #0e1834 !important;
            border-color: #38bdf8 !important;
            color: #ffffff !important;
        }

        [data-bs-theme="dark"] .modal-content {
            background-color: #0f1c36 !important;
            border-color: #1e293b !important;
            color: #f1f5f9 !important;
        }

        [data-bs-theme="dark"] .list-group-item {
            background-color: #0f1c36 !important;
            border-color: #1e293b !important;
            color: #f1f5f9 !important;
        }

        /* Botón Modo Claro/Oscuro - Idéntico a GlobalesJP */
        .theme-toggle-btn {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: #ffffff;
            border: 1px solid rgba(15, 23, 42, 0.12);
            color: #475569;
            transition: all 0.22s cubic-bezier(0.16, 1, 0.3, 1);
            cursor: pointer;
            box-shadow: 0 2px 5px rgba(0,0,0,0.06);
            outline: none;
        }

        .theme-toggle-btn:hover {
            background: #f1f5f9;
            color: #0f172a;
            transform: scale(1.08);
        }

        [data-bs-theme="dark"] .theme-toggle-btn {
            background: #0f1c36 !important;
            border: 1px solid rgba(251, 191, 36, 0.35) !important;
            color: #fbbf24 !important;
            box-shadow: 0 0 14px rgba(251, 191, 36, 0.25) !important;
        }

        [data-bs-theme="dark"] .theme-toggle-btn:hover {
            background: #17274a !important;
            border-color: #fbbf24 !important;
            color: #f59e0b !important;
            box-shadow: 0 0 20px rgba(251, 191, 36, 0.45) !important;
            transform: scale(1.1);
        }
    </style>
</head>
<body>
    <header class="sticky-top bg-white border-bottom shadow-sm">
        <nav class="navbar navbar-expand-lg navbar-light container-fluid px-lg-4 px-xl-5 py-2">
            <a class="navbar-brand navbar-brand-custom py-1 text-nowrap" asp-controller="Home" asp-action="Index">
                <img src="@siteConfig.LogoUrl" alt="Logo @siteConfig.SiteName" class="rounded-circle shadow-sm" style="width: 44px; height: 44px; object-fit: cover;" onerror="this.src='/images/logo-jp.png';" />
                <div class="d-flex flex-column justify-content-center">
                    <span class="fw-bold fs-5 text-dark" style="letter-spacing: -0.3px; line-height: 1.1;">
                        @siteConfig.SiteName <span style="color: #dc2626; font-weight: 800;">@siteConfig.SiteNameHighlight</span>
                    </span>
                    <span class="text-muted fw-semibold" style="font-size: 0.72rem; letter-spacing: 0.2px;">
                        @siteConfig.SiteSlogan
                    </span>
                </div>
            </a>
            
            <!-- Botón Dark Mode Móvil + Hamburguesa Móvil (3 Rayas) -->
            <div class="d-flex align-items-center gap-2 d-lg-none">
                <button id="themeToggleBtnMobile" class="theme-toggle-btn" type="button" title="Cambiar modo Claro / Oscuro" aria-label="Cambiar modo Claro u Oscuro" style="width: 36px; height: 36px;">
                    <i class="bi bi-moon-stars-fill fs-6 text-secondary" id="themeIconMobile"></i>
                </button>
                <button class="navbar-toggler border-0 shadow-none p-1" type="button" data-bs-toggle="offcanvas" data-bs-target="#navbarOffcanvas" aria-controls="navbarOffcanvas" aria-label="Abrir Menú">
                    <span class="navbar-toggler-icon"></span>
                </button>
            </div>

            <!-- Menú Lateral Fluido (Offcanvas en móvil / Navbar inline en escritorio) -->
            <div class="offcanvas offcanvas-end offcanvas-mobile" tabindex="-1" id="navbarOffcanvas" aria-labelledby="navbarOffcanvasLabel">
                <!-- Encabezado del Menú Lateral (Visible solo en móvil) -->
                <div class="offcanvas-header border-bottom py-3 px-3 d-lg-none bg-white">
                    <div class="d-flex align-items-center gap-2">
                        <img src="@siteConfig.LogoUrl" alt="Logo" class="rounded-circle shadow-sm" style="width: 36px; height: 36px; object-fit: cover;" onerror="this.src='/images/logo-jp.png';" />
                        <div class="d-flex flex-column">
                            <span class="fw-bold text-dark" style="font-size: 0.95rem; line-height: 1.1;">
                                @siteConfig.SiteName <span style="color: #dc2626; font-weight: 800;">@siteConfig.SiteNameHighlight</span>
                            </span>
                            <span class="text-muted" style="font-size: 0.68rem;">@siteConfig.SiteSlogan</span>
                        </div>
                    </div>
                    <button type="button" class="btn-close shadow-none" data-bs-dismiss="offcanvas" aria-label="Cerrar"></button>
                </div>

                <!-- Cuerpo del Menú Lateral -->
                <div class="offcanvas-body p-3 p-lg-0">
                    @{
                        var currentCtrl = ViewContext.RouteData.Values["controller"]?.ToString();
                        bool isAdminMode = currentCtrl == "Admin";
                        bool isCreatorMode = currentCtrl == "Creador";
                        bool isCreatorRole = User.IsInRole("Creator");
                        bool isAdminRole = User.IsInRole("Admin");

                        var userPic = User.FindFirst("ProfilePictureUrl")?.Value;
                        var rawName = User.Identity?.Name ?? "Usuario";
                        var nameParts = rawName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
                        var userInitials = nameParts.Length >= 2 
                            ? $"{nameParts[0][0]}{nameParts[1][0]}".ToUpper() 
                            : (nameParts.Length == 1 ? nameParts[0][0].ToString().ToUpper() : "U");
                    }

                    <!-- Toggle de Modo Oscuro en Menú Móvil -->
                    <div class="d-lg-none mb-3 p-2 px-3 rounded-3 bg-light border d-flex align-items-center justify-content-between">
                        <span class="fw-semibold small text-dark"><i class="bi bi-circle-half me-2 text-primary"></i>Tema visual</span>
                        <button id="themeToggleBtnMenu" class="theme-toggle-btn" type="button" style="width: 36px; height: 36px;" title="Cambiar tema">
                            <i class="bi bi-moon-stars-fill text-secondary" id="themeIconMenu"></i>
                        </button>
                    </div>

                    @* 1. Tarjeta de Usuario en MÓVIL (Visible solo en móvil) *@
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="d-lg-none p-3 mb-3 bg-light rounded-4 border">
                            <a asp-controller="Account" asp-action="Perfil" class="text-decoration-none text-dark d-flex align-items-center gap-3">
                                @if (!string.IsNullOrEmpty(userPic))
                                {
                                    <img src="@userPic" alt="Avatar" class="rounded-circle shadow-sm border border-light" style="width: 44px; height: 44px; object-fit: cover;" />
                                }
                                else
                                {
                                    <span class="rounded-circle bg-primary text-white d-inline-flex align-items-center justify-content-center fw-bold shadow-sm" style="width: 44px; height: 44px; font-size: 1rem;">
                                        @userInitials
                                    </span>
                                }
                                <div class="overflow-hidden flex-grow-1">
                                    <div class="fw-bold text-dark text-truncate">@rawName</div>
                                    <div class="text-primary small fw-semibold" style="font-size: 0.75rem;">
                                        <i class="bi bi-person-badge me-1"></i>ID: @User.FindFirst("IdentificationNumber")?.Value
                                    </div>
                                </div>
                                <i class="bi bi-chevron-right text-muted"></i>
                            </a>

                            @* Selector de Modo en Móvil *@
                            @if (isAdminRole)
                            {
                                <div class="d-flex align-items-center w-100 p-1 rounded-pill bg-white border shadow-sm mt-3" style="gap: 4px;" role="group">
                                    <a asp-controller="Account" asp-action="Dashboard" 
                                       class="btn btn-sm flex-fill rounded-pill fw-bold text-truncate border-0 @(!isAdminMode ? "btn-primary text-white shadow-xs" : "text-secondary")">
                                        <i class="bi bi-mortarboard-fill me-1"></i> Alumno
                                    </a>
                                    <a asp-controller="Admin" asp-action="Index" 
                                       class="btn btn-sm flex-fill rounded-pill fw-bold text-truncate border-0 @(isAdminMode ? "btn-danger text-white shadow-xs" : "text-secondary")">
                                        <i class="bi bi-shield-lock-fill me-1"></i> Admin
                                    </a>
                                </div>
                            }
                            else if (isCreatorRole)
                            {
                                <div class="d-flex align-items-center w-100 p-1 rounded-pill bg-white border shadow-sm mt-3" style="gap: 4px;" role="group">
                                    <a asp-controller="Account" asp-action="Dashboard" 
                                       class="btn btn-sm flex-fill rounded-pill fw-bold text-truncate border-0 @(!isCreatorMode ? "btn-primary text-white shadow-xs" : "text-secondary")">
                                        <i class="bi bi-mortarboard-fill me-1"></i> Alumno
                                    </a>
                                    <a asp-controller="Creador" asp-action="Cursos" 
                                       class="btn btn-sm flex-fill rounded-pill fw-bold text-truncate border-0 @(isCreatorMode ? "btn-warning text-dark shadow-xs" : "text-secondary")">
                                        <i class="bi bi-palette-fill me-1"></i> Creador
                                    </a>
                                </div>
                            }
                        </div>
                    }

                    @* 2. Navegación Principal (Izquierda en desktop / Vertical en móvil) *@
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3 align-items-lg-center flex-column flex-lg-row gap-1">
                        <li class="nav-item">
                            <a class="nav-link fw-semibold text-nowrap py-2 py-lg-1 px-2 rounded-3" asp-controller="Cursos" asp-action="Index">
                                <i class="bi bi-grid-fill me-2 me-lg-1 text-primary"></i> Catálogo Completo
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link fw-semibold text-nowrap py-2 py-lg-1 px-2 rounded-3" asp-controller="Curriculum" asp-action="Index">
                                <i class="bi bi-file-earmark-person-fill me-2 me-lg-1 text-primary"></i> Crear CV con IA <span class="badge bg-success bg-opacity-25 text-success rounded-pill fw-bold" style="font-size: 0.72rem;">$1</span>
                            </a>
                        </li>
                        @if (!isAdminMode && !isCreatorMode)
                        {
                            <li class="nav-item">
                                <a class="nav-link fw-semibold text-nowrap py-2 py-lg-1 px-2 rounded-3" asp-controller="Certificados" asp-action="Verificar">
                                    <i class="bi bi-patch-check-fill me-2 me-lg-1 text-warning"></i> Validar Certificado
                                </a>
                            </li>
                            @if (User.Identity?.IsAuthenticated != true || (!User.IsInRole("Admin") && !User.IsInRole("Creator")))
                            {
                                <li class="nav-item">
                                    <a class="nav-link fw-bold text-warning text-nowrap py-2 py-lg-1 px-2 rounded-3" asp-controller="Membresia" asp-action="Creador">
                                        <i class="bi bi-star-fill me-2 me-lg-1"></i> Ser Creador ($10)
                                    </a>
                                </li>
                            }
                        }
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @if (isAdminMode)
                            {
                                <li class="nav-item d-none d-lg-block ms-1">
                                    <span class="badge bg-danger bg-opacity-10 text-danger fw-bold px-3 py-1 border border-danger border-opacity-25 rounded-pill text-nowrap">
                                        <i class="bi bi-shield-lock-fill me-1"></i> Modo Admin
                                    </span>
                                </li>
                            }
                            else if (isCreatorMode)
                            {
                                <li class="nav-item d-none d-lg-block ms-1">
                                    <span class="badge bg-warning bg-opacity-10 text-warning-emphasis fw-bold px-3 py-1 border border-warning border-opacity-25 rounded-pill text-nowrap">
                                        <i class="bi bi-palette-fill me-1"></i> Modo Creador
                                    </span>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item d-none d-lg-block ms-1">
                                    <span class="badge bg-primary bg-opacity-10 text-primary fw-bold px-3 py-1 border border-primary border-opacity-25 rounded-pill text-nowrap">
                                        <i class="bi bi-mortarboard-fill me-1"></i> Modo Alumno
                                    </span>
                                </li>
                            }
                        }
                    </ul>

                    @* 3. Navegación Secundaria (Derecha en desktop / Resto del menú en móvil) *@
                    <ul class="navbar-nav align-items-lg-center gap-2 flex-column flex-lg-row ms-auto">
                        <!-- Botón Dark Mode Desktop (estilo idéntico a globalesjp.net) -->
                        <li class="nav-item d-none d-lg-flex align-items-center me-1">
                            <button id="themeToggleBtnDesktop" class="theme-toggle-btn" type="button" title="Cambiar modo Claro / Oscuro" aria-label="Cambiar modo Claro u Oscuro">
                                <i class="bi bi-moon-stars-fill fs-5 text-secondary" id="themeIconDesktop"></i>
                            </button>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @if (!isAdminMode)
                            {
                                <li class="nav-item">
                                    <a class="nav-link fw-bold text-primary text-nowrap py-2 py-lg-1 px-2 rounded-3" asp-controller="Account" asp-action="Dashboard">
                                        <i class="bi bi-journal-bookmark-fill me-2 me-lg-1"></i> Mis Cursos
                                    </a>
                                </li>
                            }
                            @if (isAdminRole)
                            {
                                <li class="nav-item d-none d-lg-block">
                                    <div class="d-inline-flex align-items-center p-1 rounded-pill bg-light border shadow-sm" style="gap: 4px;" role="group" aria-label="Selector de Modo">
                                        <a asp-controller="Account" asp-action="Dashboard" 
                                           class="btn btn-sm rounded-pill px-3 py-1 fw-bold text-nowrap border-0 @(!isAdminMode ? "btn-primary text-white shadow-sm" : "text-secondary")"
                                           style="font-size: 0.82rem; transition: all 0.2s ease;"
                                           title="Modo Alumno: ver mis cursos, catálogo y avance como estudiante">
                                            <i class="bi bi-mortarboard-fill me-1"></i> Alumno
                                        </a>
                                        <a asp-controller="Admin" asp-action="Index" 
                                           class="btn btn-sm rounded-pill px-3 py-1 fw-bold text-nowrap border-0 @(isAdminMode ? "btn-danger text-white shadow-sm" : "text-secondary")"
                                           style="font-size: 0.82rem; transition: all 0.2s ease;"
                                           title="Modo Admin: conciliar pagos, gestionar catálogo y estudiantes">
                                            <i class="bi bi-shield-lock-fill me-1"></i> Admin
                                        </a>
                                    </div>
                                </li>
                            }
                            else if (isCreatorRole)
                            {
                                <li class="nav-item d-none d-lg-block">
                                    <div class="d-inline-flex align-items-center p-1 rounded-pill bg-light border shadow-sm" style="gap: 4px;" role="group" aria-label="Selector de Modo Creador">
                                        <a asp-controller="Account" asp-action="Dashboard" 
                                           class="btn btn-sm rounded-pill px-3 py-1 fw-bold text-nowrap border-0 @(!isCreatorMode ? "btn-primary text-white shadow-sm" : "text-secondary")"
                                           style="font-size: 0.82rem; transition: all 0.2s ease;"
                                           title="Modo Alumno: ver mis cursos y avance como estudiante">
                                            <i class="bi bi-mortarboard-fill me-1"></i> Alumno
                                        </a>
                                        <a asp-controller="Creador" asp-action="Cursos" 
