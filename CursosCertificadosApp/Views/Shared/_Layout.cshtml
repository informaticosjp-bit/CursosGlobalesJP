    <script>
        // Toggle visualización de contraseñas (ojito en campos password)
        document.addEventListener('click', function (e) {
            const btn = e.target.closest('.toggle-password');
            if (!btn) return;
            e.preventDefault();
            const group = btn.closest('.input-group');
            if (!group) return;
            const input = group.querySelector('input');
            if (!input) return;
            const icon = btn.querySelector('i');

            if (input.type === 'password') {
                input.type = 'text';
                if (icon) {
                    icon.classList.remove('bi-eye');
                    icon.classList.add('bi-eye-slash');
                }
            } else {
                input.type = 'password';
                if (icon) {
                    icon.classList.remove('bi-eye-slash');
                    icon.classList.add('bi-eye');
                }
            }
        });
    </script>

    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
        var currentPath = Context.Request.Path.Value ?? "/";
        var isHomePage = (string.Equals(currentController, "Home", StringComparison.OrdinalIgnoreCase) && 
                          string.Equals(currentAction, "Index", StringComparison.OrdinalIgnoreCase))
                         || currentPath == "/"
                         || string.Equals(currentPath, "/Home", StringComparison.OrdinalIgnoreCase)
                         || string.Equals(currentPath, "/Home/Index", StringComparison.OrdinalIgnoreCase);
    }

    @if (isHomePage && siteConfig.PopupIsEnabled && !string.IsNullOrWhiteSpace(siteConfig.PopupMessage))
    {
        <!-- Modal Global de Popup / Anuncio para Visitantes (Exclusivo Página de Inicio) -->
        <div class="modal fade" id="modalAnuncioGlobal" tabindex="-1" aria-labelledby="modalAnuncioGlobalLabel" aria-hidden="true" data-bs-backdrop="static">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                    <div class="modal-header @siteConfig.PopupHeaderClass border-0 py-3">
                        <h5 class="modal-title fw-bold d-flex align-items-center gap-2 mb-0" id="modalAnuncioGlobalLabel">
                            <i class="bi @siteConfig.PopupIconClass fs-4"></i>
                            <span>@(string.IsNullOrWhiteSpace(siteConfig.PopupTitle) ? "Aviso Importante" : siteConfig.PopupTitle)</span>
                        </h5>
                        <button type="button" class="btn-close @(siteConfig.PopupType == "warning" || siteConfig.PopupType == "info" ? "" : "btn-close-white")" data-bs-dismiss="modal" aria-label="Close" onclick="marcarAnuncioVisto()"></button>
                    </div>
                    <div class="modal-body p-4 bg-white text-dark">
                        <div style="font-size: 0.95rem; line-height: 1.6; white-space: pre-line;">@siteConfig.PopupMessage</div>
                    </div>
                    <div class="modal-footer bg-light border-0 py-2 d-flex justify-content-between align-items-center">
                        <span class="small text-muted" style="font-size: 0.75rem;">
                            <i class="bi bi-broadcast text-primary me-1"></i>Comunicado Oficial
                        </span>
                        <div class="d-flex gap-2">
                            @if (!string.IsNullOrWhiteSpace(siteConfig.PopupActionUrl))
                            {
                                <a href="@siteConfig.PopupActionUrl" class="btn btn-sm btn-outline-primary fw-semibold" target="_blank">
                                    @(string.IsNullOrWhiteSpace(siteConfig.PopupActionText) ? "Más información" : siteConfig.PopupActionText)
                                    <i class="bi bi-box-arrow-up-right ms-1"></i>
                                </a>
                            }
                            <button type="button" class="btn btn-sm btn-dark fw-bold px-3" data-bs-dismiss="modal" onclick="marcarAnuncioVisto()">
                                @(string.IsNullOrWhiteSpace(siteConfig.PopupButtonText) ? "Entendido" : siteConfig.PopupButtonText)
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <script>
            (function () {
                // Validación estricta de ruta en frontend: Solo ejecutar en la página de inicio
                var pathname = window.location.pathname.toLowerCase();
                if (pathname !== '/' && pathname !== '/home' && pathname !== '/home/index') {
                    return; // No ejecuta la ventana emergente en rutas secundarias
                }

                var popupVersion = "@siteConfig.PopupVersion";
                var showOnce = @(siteConfig.PopupShowOnce ? "true" : "false");
                var storageKey = "cgjp_popup_seen_" + popupVersion;

                window.marcarAnuncioVisto = function () {
                    if (showOnce) {
                        try {
                            localStorage.setItem(storageKey, "true");
                        } catch (e) { }
                    }
                };

                function abrirModal() {
                    var el = document.getElementById("modalAnuncioGlobal");
                    if (!el) return;
                    if (typeof bootstrap !== "undefined" && bootstrap.Modal) {
                        var modal = bootstrap.Modal.getInstance(el) || new bootstrap.Modal(el);
                        modal.show();
                    } else if (typeof jQuery !== "undefined" && jQuery(el).modal) {
                        jQuery(el).modal('show');
                    } else {
                        setTimeout(abrirModal, 200);
                    }
                }

                function inicializarPopup() {
                    if (!showOnce || !localStorage.getItem(storageKey)) {
                        setTimeout(abrirModal, 400);
                    }
                }

                if (document.readyState === "complete" || document.readyState === "interactive") {
                    inicializarPopup();
                } else {
                    window.addEventListener("DOMContentLoaded", inicializarPopup);
                }
            })();
        </script>
    }

    <!-- Script de Control de Modo Oscuro / Claro (GlobalesJP Theme) -->
    <script>
        (function () {
            const STORAGE_KEY = 'cgjp_theme_mode';

            function getPreferredTheme() {
                try {
                    const stored = localStorage.getItem(STORAGE_KEY);
                    if (stored === 'dark' || stored === 'light') return stored;
                } catch (e) { }
                return 'light';
            }

            function updateThemeUI(theme) {
                const isDark = theme === 'dark';

                // Actualizar iconos
                const desktopIcon = document.getElementById('themeIconDesktop');
                if (desktopIcon) {
                    desktopIcon.className = isDark ? 'bi bi-sun-fill fs-5 text-warning' : 'bi bi-moon-stars-fill fs-5 text-secondary';
                }
                const mobileIcon = document.getElementById('themeIconMobile');
                if (mobileIcon) {
                    mobileIcon.className = isDark ? 'bi bi-sun-fill fs-6 text-warning' : 'bi bi-moon-stars-fill fs-6 text-secondary';
                }
                const menuIcon = document.getElementById('themeIconMenu');
                if (menuIcon) {
                    menuIcon.className = isDark ? 'bi bi-sun-fill text-warning' : 'bi bi-moon-stars-fill text-secondary';
                }

                // Tooltips / Títulos
                const titleText = isDark ? 'Cambiar a modo Claro' : 'Cambiar a modo Oscuro';
                ['themeToggleBtnDesktop', 'themeToggleBtnMobile', 'themeToggleBtnMenu'].forEach(function(id) {
                    const btn = document.getElementById(id);
                    if (btn) btn.setAttribute('title', titleText);
                });
            }

            function applyTheme(theme) {
                document.documentElement.setAttribute('data-bs-theme', theme);
                document.documentElement.setAttribute('data-theme', theme);
                try {
                    localStorage.setItem(STORAGE_KEY, theme);
                } catch (e) { }
                updateThemeUI(theme);
            }

            window.toggleAppTheme = function () {
                const current = document.documentElement.getAttribute('data-bs-theme') || 'light';
                const next = current === 'dark' ? 'light' : 'dark';
                applyTheme(next);
            };

            function initThemeEvents() {
                const currentTheme = document.documentElement.getAttribute('data-bs-theme') || getPreferredTheme();
                updateThemeUI(currentTheme);

                ['themeToggleBtnDesktop', 'themeToggleBtnMobile', 'themeToggleBtnMenu'].forEach(function(id) {
                    const btn = document.getElementById(id);
                    if (btn) {
                        btn.addEventListener('click', window.toggleAppTheme);
                    }
                });
            }

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', initThemeEvents);
            } else {
                initThemeEvents();
            }
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
