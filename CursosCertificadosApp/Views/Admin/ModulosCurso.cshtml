@model CursosCertificadosApp.Models.Entities.Course
@{
    ViewData["Title"] = $"Módulos y Lecturas: {Model.Title}";
}

<div class="container py-4">
    <!-- Encabezado y Navegación Fija Centralizada -->
    <partial name="_AdminHeader" />

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h4 class="fw-bold mb-0 text-dark">
                <i class="bi bi-journal-text text-primary me-2"></i>Estructura y Contenido del Curso
            </h4>
            <span class="text-muted small"><strong>@Model.Title</strong> (@Model.Category.Name · @Model.Level)</span>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-action="EditarCurso" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
                <i class="bi bi-pencil me-1"></i> Editar Información Básica
            </a>
            <a asp-controller="Aula" asp-action="Aula" asp-route-slug="@Model.Slug" target="_blank" class="btn btn-outline-info">
                <i class="bi bi-eye me-1"></i> Ver en Aula
            </a>
            <a asp-action="Cursos" class="btn btn-outline-dark">
                <i class="bi bi-arrow-left me-1"></i> Volver a Cursos
            </a>
        </div>
    </div>

    <div class="row g-4">
        <!-- Columna Izquierda: Temario de Módulos y Lecturas Formativas -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0">Módulos Formativos y Guías de Estudio</h5>
                    <button class="btn btn-sm btn-primary fw-bold" data-bs-toggle="modal" data-bs-target="#modalCrearModulo">
                        <i class="bi bi-plus-lg me-1"></i> Agregar Módulo
                    </button>
                </div>

                @if (!Model.Modules.Any())
                {
                    <div class="alert alert-warning text-center py-4 border-0">
                        <i class="bi bi-exclamation-triangle fs-2 d-block mb-2"></i>
                        Este curso no tiene módulos asignados todavía. Pulsa <strong>Agregar Módulo</strong> para comenzar a estructurar el temario.
                    </div>
                }
                else
                {
                    <div class="accordion" id="accordionModulos">
                        @foreach (var mod in Model.Modules.OrderBy(m => m.OrderIndex))
                        {
                            <div class="accordion-item mb-3 border rounded-3 overflow-hidden shadow-sm">
                                <div class="accordion-header bg-white p-2 d-flex justify-content-between align-items-center border-bottom" id="heading_@mod.Id">
                                    <button class="accordion-button collapsed fw-bold py-2 bg-transparent border-0 shadow-none text-dark flex-grow-1" type="button" data-bs-toggle="collapse" data-bs-target="#collapse_@mod.Id">
                                        <i class="bi bi-folder2-open me-2 text-primary"></i>
                                        <span>@mod.Title</span>
                                        <span class="badge bg-light text-dark border ms-3 small">@mod.Lessons.Count lecturas</span>
                                    </button>
                                    
                                    <!-- Botones de Gestión del Módulo -->
                                    <div class="d-flex gap-1 ms-2">
                                        <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#modalEditarModulo_@mod.Id" title="Editar Título del Módulo">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <form asp-action="EliminarModulo" method="post" class="d-inline" onsubmit="return confirm('¿Seguro que deseas eliminar este módulo y todas sus lecturas?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="moduleId" value="@mod.Id" />
                                            <input type="hidden" name="courseId" value="@Model.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Eliminar Módulo">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </div>

                                <div id="collapse_@mod.Id" class="accordion-collapse collapse show" data-bs-parent="#accordionModulos">
                                    <div class="accordion-body bg-light">
                                        <div class="d-flex justify-content-between align-items-center mb-3">
                                            <span class="small text-muted fw-semibold">Contenido interactivo, videos y recursos:</span>
                                            <button class="btn btn-sm btn-success fw-semibold" data-bs-toggle="modal" data-bs-target="#modalCrearLeccion_@mod.Id">
                                                <i class="bi bi-plus-circle me-1"></i> Agregar Lectura
                                            </button>
                                        </div>

                                        @if (!mod.Lessons.Any())
                                        {
                                            <div class="alert alert-light border small text-muted text-center py-3 mb-0">
                                                No hay lecturas en este módulo. Pulsa <strong>Agregar Lectura</strong> para redactar la primera guía interactiva.
                                            </div>
                                        }
                                        else
                                        {
                                            <ul class="list-group list-group-flush rounded-3 border">
                                                @foreach (var lesson in mod.Lessons.OrderBy(l => l.OrderIndex))
                                                {
                                                    <li class="list-group-item d-flex flex-wrap justify-content-between align-items-center bg-white py-2 gap-2">
                                                        <div class="d-flex align-items-center">
                                                            <i class="bi bi-file-text-fill text-primary me-2 fs-5"></i>
                                                            <div>
                                                                <strong class="text-dark d-block">@lesson.Title</strong>
                                                                <span class="text-muted small">@lesson.DurationMinutes minutos de estudio · Orden: @lesson.OrderIndex</span>
                                                            </div>
                                                        </div>

                                                        <div class="d-flex gap-2">
                                                            <!-- Botón para Editar Lectura Existente -->
                                                            <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#modalEditarLeccion_@lesson.Id">
                                                                <i class="bi bi-pencil-square me-1"></i> Editar Contenido
                                                            </button>

                                                            <!-- Botón Eliminar Lectura -->
                                                            <form asp-action="EliminarLeccion" method="post" class="d-inline" onsubmit="return confirm('¿Seguro que deseas eliminar esta lectura?');">
                                                                @Html.AntiForgeryToken()
                                                                <input type="hidden" name="lessonId" value="@lesson.Id" />
                                                                <input type="hidden" name="courseId" value="@Model.Id" />
                                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Eliminar Lectura">
                                                                    <i class="bi bi-trash"></i>
                                                                </button>
                                                            </form>
                                                        </div>
                                                    </li>

                                                    <!-- Modal Editar Lección Existente -->
                                                    <div class="modal fade" id="modalEditarLeccion_@lesson.Id" tabindex="-1" aria-hidden="true">
                                                        <div class="modal-dialog modal-xl modal-dialog-centered">
                                                            <div class="modal-content text-start">
                                                                <div class="modal-header bg-light">
                                                                    <h5 class="modal-title fw-bold">
                                                                        <i class="bi bi-pencil-square me-2 text-primary"></i>Editar Lectura: @lesson.Title
                                                                    </h5>
                                                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                                </div>
                                                                <form asp-action="EditarLeccion" method="post">
                                                                    @Html.AntiForgeryToken()
                                                                    <input type="hidden" name="lessonId" value="@lesson.Id" />
                                                                    <input type="hidden" name="courseId" value="@Model.Id" />

                                                                    <div class="modal-body">
                                                                        <div class="row g-2 mb-3">
                                                                            <div class="col-md-8">
                                                                                <label class="form-label small fw-bold">Título de la Lectura / Tema:</label>
                                                                                <input type="text" name="title" class="form-control" value="@lesson.Title" required />
                                                                            </div>
                                                                            <div class="col-md-2">
                                                                                <label class="form-label small fw-bold">Tiempo (min):</label>
                                                                                <input type="number" name="durationMinutes" class="form-control" value="@lesson.DurationMinutes" min="5" max="180" required />
                                                                            </div>
                                                                            <div class="col-md-2">
                                                                                <label class="form-label small fw-bold">Orden:</label>
                                                                                <input type="number" name="orderIndex" class="form-control" value="@lesson.OrderIndex" required />
                                                                            </div>
                                                                        </div>

                                                                        <div class="mb-2">
                                                                            <label class="form-label small fw-bold">Contenido Formativo (HTML enriquecido, videos y recursos visuales):</label>
                                                                            <textarea id="content_edit_@lesson.Id" name="content" class="form-control font-monospace rounded-bottom-0" rows="12" required>@lesson.ContentHtml</textarea>
                                                                            
                                                                            <!-- Barra de Herramientas Multimedia: YouTube + Subir Imagen -->
                                                                            <div class="d-flex flex-wrap align-items-center justify-content-between p-2 bg-light border border-top-0 rounded-bottom">
                                                                                <div class="d-flex flex-wrap align-items-center gap-2">
                                                                                    <button type="button" class="btn btn-sm btn-outline-danger fw-semibold" onclick="insertarVideoYoutube('content_edit_@lesson.Id')">
                                                                                        <i class="bi bi-youtube me-1"></i> Agregar Link de YouTube (Video)
                                                                                    </button>
                                                                                    <label class="btn btn-sm btn-outline-primary fw-semibold mb-0" style="cursor: pointer;">
                                                                                        <i class="bi bi-image me-1"></i> Subir / Agregar Imagen
                                                                                        <input type="file" accept="image/*" class="d-none" onchange="subirImagenAEditor(this, 'content_edit_@lesson.Id')" />
                                                                                    </label>
                                                                                    <div class="btn-group btn-group-sm">
                                                                                        <button type="button" class="btn btn-outline-secondary" onclick="insertarFormato('content_edit_@lesson.Id', 'h3')" title="Insertar Subtítulo">
                                                                                            <i class="bi bi-type-h3"></i> Título
                                                                                        </button>
                                                                                        <button type="button" class="btn btn-outline-secondary" onclick="insertarFormato('content_edit_@lesson.Id', 'alert')" title="Insertar Caja Destacada">
                                                                                            <i class="bi bi-info-circle"></i> Info
                                                                                        </button>
                                                                                    </div>
                                                                                </div>
                                                                                <span class="small text-muted" style="font-size: 0.72rem;">
                                                                                    <i class="bi bi-check2-circle text-success me-1"></i>Se verá en vivo en el aula del estudiante
                                                                                </span>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                    <div class="modal-footer bg-light">
                                                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                                                        <button type="submit" class="btn btn-primary fw-bold px-4">
                                                                            <i class="bi bi-save me-1"></i> Guardar Cambios de la Lectura
                                                                        </button>
                                                                    </div>
                                                                </form>
                                                            </div>
                                                        </div>
                                                    </div>
                                                }
                                            </ul>
                                        }
                                    </div>
                                </div>
                            </div>

                            <!-- Modal Editar Título del Módulo -->
                            <div class="modal fade" id="modalEditarModulo_@mod.Id" tabindex="-1" aria-hidden="true">
                                <div class="modal-dialog modal-dialog-centered">
                                    <div class="modal-content text-start">
                                        <div class="modal-header bg-light">
                                            <h5 class="modal-title fw-bold">
                                                <i class="bi bi-pencil me-1 text-primary"></i> Editar Módulo: @mod.Title
                                            </h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                        </div>
                                        <form asp-action="EditarModulo" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="moduleId" value="@mod.Id" />
                                            <input type="hidden" name="courseId" value="@Model.Id" />

                                            <div class="modal-body">
                                                <div class="mb-3">
                                                    <label class="form-label small fw-bold">Título del Módulo:</label>
                                                    <input type="text" name="title" class="form-control" value="@mod.Title" required />
                                                </div>
                                                <div class="mb-2">
                                                    <label class="form-label small fw-bold">Orden de Aparición:</label>
                                                    <input type="number" name="orderIndex" class="form-control" value="@mod.OrderIndex" required />
                                                </div>
                                            </div>
                                            <div class="modal-footer bg-light">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                                <button type="submit" class="btn btn-primary fw-bold">Guardar Módulo</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>

                            <!-- Modal Agregar Nueva Lección en este Módulo -->
                            <div class="modal fade" id="modalCrearLeccion_@mod.Id" tabindex="-1" aria-hidden="true">
                                <div class="modal-dialog modal-xl modal-dialog-centered">
                                    <div class="modal-content text-start">
                                        <div class="modal-header bg-light">
                                            <h5 class="modal-title fw-bold">
                                                <i class="bi bi-file-earmark-plus me-1 text-success"></i> Nueva Lectura para: @mod.Title
                                            </h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                        </div>
                                        <form asp-action="CrearLeccion" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="moduleId" value="@mod.Id" />
                                            <input type="hidden" name="courseId" value="@Model.Id" />

                                            <div class="modal-body">
                                                <div class="row g-2 mb-3">
                                                    <div class="col-md-8">
                                                        <label class="form-label small fw-bold">Título de la Lectura / Sección:</label>
                                                        <input type="text" name="title" class="form-control" placeholder="Ej. 1.2 Métodos de Optimización y Análisis de Datos" required />
                                                    </div>
                                                    <div class="col-md-2">
                                                        <label class="form-label small fw-bold">Tiempo (min):</label>
                                                        <input type="number" name="estimatedMinutes" class="form-control" value="15" min="5" max="180" required />
                                                    </div>
                                                    <div class="col-md-2">
                                                        <label class="form-label small fw-bold">Orden:</label>
                                                        <input type="number" name="orderIndex" class="form-control" value="@(mod.Lessons.Count + 1)" required />
                                                    </div>
                                                </div>

                                                <div class="mb-2">
                                                    <label class="form-label small fw-bold">Contenido Formativo Teórico (Soporta HTML, Videos de YouTube y Recursos Visuales):</label>
                                                    <textarea id="content_create_@mod.Id" name="content" class="form-control font-monospace rounded-bottom-0" rows="10" placeholder="Escribe aquí el contenido estructurado de la lectura, explicaciones, ejemplos prácticos, tablas y diagramas..." required></textarea>
                                                    
                                                    <!-- Barra de Herramientas Multimedia: YouTube + Subir Imagen -->
                                                    <div class="d-flex flex-wrap align-items-center justify-content-between p-2 bg-light border border-top-0 rounded-bottom">
                                                        <div class="d-flex flex-wrap align-items-center gap-2">
                                                            <button type="button" class="btn btn-sm btn-outline-danger fw-semibold" onclick="insertarVideoYoutube('content_create_@mod.Id')">
                                                                <i class="bi bi-youtube me-1"></i> Agregar Link de YouTube (Video)
                                                            </button>
                                                            <label class="btn btn-sm btn-outline-primary fw-semibold mb-0" style="cursor: pointer;">
                                                                <i class="bi bi-image me-1"></i> Subir / Agregar Imagen
                                                                <input type="file" accept="image/*" class="d-none" onchange="subirImagenAEditor(this, 'content_create_@mod.Id')" />
                                                            </label>
                                                            <div class="btn-group btn-group-sm">
                                                                <button type="button" class="btn btn-outline-secondary" onclick="insertarFormato('content_create_@mod.Id', 'h3')" title="Insertar Subtítulo">
                                                                    <i class="bi bi-type-h3"></i> Título
                                                                </button>
                                                                <button type="button" class="btn btn-outline-secondary" onclick="insertarFormato('content_create_@mod.Id', 'alert')" title="Insertar Caja Destacada">
                                                                    <i class="bi bi-info-circle"></i> Info
                                                                </button>
                                                            </div>
                                                        </div>
                                                        <span class="small text-muted" style="font-size: 0.72rem;">
                                                            <i class="bi bi-check2-circle text-success me-1"></i>Incrustación interactiva
                                                        </span>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="modal-footer bg-light">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                                <button type="submit" class="btn btn-success fw-bold px-4">
                                                    <i class="bi bi-check-lg me-1"></i> Guardar Lectura
                                                </button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- Columna Derecha: Evaluación Sumativa y Certificación -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
                <h5 class="fw-bold mb-3 d-flex align-items-center gap-2">
                    <i class="bi bi-patch-question-fill text-warning"></i> Evaluación Sumativa
                </h5>
                @if (Model.Quiz != null)
                {
                    <div class="p-3 bg-light rounded-3 mb-3">
                        <span class="d-block small text-muted">Título del Cuestionario:</span>
                        <strong class="text-dark">@Model.Quiz.Title</strong>
                        <div class="d-flex justify-content-between mt-2 pt-2 border-top small">
                            <span>Preguntas activas:</span>
                            <span class="badge bg-primary">@Model.Quiz.Questions.Count preguntas</span>
                        </div>
                        <div class="d-flex justify-content-between mt-1 small">
                            <span>Puntaje mínimo:</span>
                            <span class="badge bg-success">@Model.PassingScore.ToString("F0")%</span>
                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-light border small text-muted mb-0">
                        <i class="bi bi-info-circle me-1 text-primary"></i> Las pruebas sumativas de opción múltiple se evalúan automáticamente al completar las lecturas del curso.
                    </div>
                }
            </div>

            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                <h6 class="fw-bold text-dark mb-2">Información del Programa</h6>
                <div class="small mb-1"><span class="text-muted">Horas lectivas:</span> <strong>@Model.EstimatedHours horas</strong></div>
                <div class="small mb-1"><span class="text-muted">Nivel:</span> <strong>@Model.Level</strong></div>
                <div class="small mb-1"><span class="text-muted">Slug de acceso:</span> <code>@Model.Slug</code></div>
                <div class="small mb-2"><span class="text-muted">Estado:</span> @(Model.IsPublished ? "Publicado" : "Borrador")</div>
                <a asp-controller="Aula" asp-action="Aula" asp-route-slug="@Model.Slug" target="_blank" class="btn btn-outline-primary btn-sm w-100 fw-semibold">
                    <i class="bi bi-box-arrow-up-right me-1"></i> Abrir Aula del Curso
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Modal Crear Módulo -->
<div class="modal fade" id="modalCrearModulo" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content text-start">
            <div class="modal-header bg-light">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-folder-plus me-1 text-primary"></i> Agregar Nuevo Módulo al Curso
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="CrearModulo" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="courseId" value="@Model.Id" />

                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Título del Módulo:</label>
                        <input type="text" name="title" class="form-control" placeholder="Ej. Módulo 2: Protocolos de Reanimación Avanzada" required />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small fw-bold">Orden del Módulo:</label>
                        <input type="number" name="orderIndex" class="form-control" value="@(Model.Modules.Count + 1)" required />
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary fw-bold">Guardar Módulo</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function extractYoutubeId(url) {
            if (!url) return null;
            var match = url.match(/(?:youtu\.be\/|youtube\.com\/(?:embed\/|v\/|watch\?v=|watch\?.+&v=))([\w-]{11})/);
            return match ? match[1] : null;
        }

        function insertarTextoEnTextarea(textareaId, texto) {
            var el = document.getElementById(textareaId);
            if (!el) return;
            var start = el.selectionStart || el.value.length;
            var end = el.selectionEnd || el.value.length;
            var before = el.value.substring(0, start);
            var after = el.value.substring(end);
            el.value = before + texto + after;
            el.focus();
            el.selectionStart = el.selectionEnd = start + texto.length;
        }

        function insertarVideoYoutube(textareaId) {
            var url = prompt("Pega aquí el enlace del video de YouTube (ejemplo: https://www.youtube.com/watch?v=... o https://youtu.be/...):");
            if (!url) return;
            var videoId = extractYoutubeId(url.trim());
            if (!videoId) {
                alert("No se pudo reconocer un ID de video de YouTube válido en el enlace proporcionado.");
                return;
            }
            var embedCode = '\n<div class="ratio ratio-16x9 my-3 rounded-3 shadow-sm overflow-hidden">\n' +
                '  <iframe src="https://www.youtube.com/embed/' + videoId + '" title="Video educativo" allowfullscreen></iframe>\n' +
                '</div>\n';
            insertarTextoEnTextarea(textareaId, embedCode);
        }

        async function subirImagenAEditor(fileInput, textareaId) {
            if (!fileInput.files || fileInput.files.length === 0) return;
            var file = fileInput.files[0];
            var formData = new FormData();
            formData.append("imageFile", file);

            try {
                var resp = await fetch("/Admin/SubirImagenContenido", {
                    method: "POST",
                    body: formData
                });
                var data = await resp.json();
                if (data.success) {
                    var imgCode = '\n<div class="text-center my-3">\n' +
                        '  <img src="' + data.url + '" class="img-fluid rounded-3 shadow-sm border" alt="Recurso visual del tema" style="max-height: 480px;" />\n' +
                        '</div>\n';
                    insertarTextoEnTextarea(textareaId, imgCode);
                } else {
                    alert(data.message || "Error al subir la imagen");
                }
            } catch (err) {
                alert("Ocurrió un error al subir la imagen.");
            }
            fileInput.value = "";
        }

        function insertarFormato(textareaId, tipo) {
            if (tipo === 'h3') {
                insertarTextoEnTextarea(textareaId, '\n<h3>Título de la Sección</h3>\n<p>Escribe aquí la explicación...</p>\n');
            } else if (tipo === 'alert') {
                insertarTextoEnTextarea(textareaId, '\n<div class="alert alert-info border-0 rounded-3 my-3 p-3">\n  <strong><i class="bi bi-info-circle me-1"></i> Punto Clave:</strong> Escribe aquí una nota o recomendación importante.\n</div>\n');
            }
        }
    </script>
}
