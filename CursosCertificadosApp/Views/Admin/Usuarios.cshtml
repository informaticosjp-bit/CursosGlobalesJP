                            <div class="table-responsive">
                                <table class="table table-sm table-bordered">
                                    <thead class="table-light small">
                                        <tr>
                                            <th>Curso</th>
                                            <th>Progreso</th>
                                            <th>Estado Académico</th>
                                            <th>Certificado Oficial</th>
                                        </tr>
                                    </thead>
