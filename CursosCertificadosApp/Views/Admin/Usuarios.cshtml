@section Scripts {
<script>
    let sortStateUsuarios = { colIndex: null, direction: 'asc' };

    function toggleSortUsuarios(colIndex, type, event) {
        if (event.target.closest('.sort-arrow-up') || event.target.closest('.sort-arrow-down')) {
            return;
        }
        let newDir = 'asc';
        if (sortStateUsuarios.colIndex === colIndex) {
            newDir = (sortStateUsuarios.direction === 'asc') ? 'desc' : 'asc';
        }
        ejecutarOrdenamientoUsuarios(colIndex, type, newDir);
    }

    function setExplicitSortUsuarios(colIndex, type, direction, event) {
        event.stopPropagation();
        ejecutarOrdenamientoUsuarios(colIndex, type, direction);
    }

    function ejecutarOrdenamientoUsuarios(colIndex, type, direction) {
        sortStateUsuarios = { colIndex: colIndex, direction: direction };
        actualizarIconosUsuarios(colIndex, direction);

        const tbody = document.getElementById('tablaUsuariosBody');
        if (!tbody) return;
        const rows = Array.from(tbody.querySelectorAll('tr.usuario-fila'));

        rows.sort((a, b) => {
            let valA = '';
            let valB = '';

            switch (colIndex) {
                case 0: // Nombre
                    valA = a.getAttribute('data-name') || '';
                    valB = b.getAttribute('data-name') || '';
                    break;
                case 1: // Rol
                    valA = a.getAttribute('data-role') || '';
                    valB = b.getAttribute('data-role') || '';
                    break;
                case 2: // Cédula
                    valA = a.getAttribute('data-idnumber') || '';
                    valB = b.getAttribute('data-idnumber') || '';
                    break;
                case 3: // Correo
                    valA = a.getAttribute('data-email') || '';
                    valB = b.getAttribute('data-email') || '';
                    break;
                case 4: // Edad
                    valA = parseFloat(a.getAttribute('data-age') || '0');
                    valB = parseFloat(b.getAttribute('data-age') || '0');
                    break;
                case 6: // Cursos
                    valA = parseInt(a.getAttribute('data-courses') || '0', 10);
                    valB = parseInt(b.getAttribute('data-courses') || '0', 10);
                    break;
                case 7: // Certificados
                    valA = parseInt(a.getAttribute('data-certificates') || '0', 10);
                    valB = parseInt(b.getAttribute('data-certificates') || '0', 10);
                    break;
                case 8: // Fecha Registro
                    valA = a.getAttribute('data-date') || '';
                    valB = b.getAttribute('data-date') || '';
                    break;
            }

            if (type === 'num') {
                return direction === 'asc' ? valA - valB : valB - valA;
            } else {
                return direction === 'asc'
                    ? valA.localeCompare(valB, 'es', { sensitivity: 'base' })
                    : valB.localeCompare(valA, 'es', { sensitivity: 'base' });
            }
        });

        rows.forEach(r => tbody.appendChild(r));
    }

    function actualizarIconosUsuarios(activeColIndex, direction) {
        const ths = document.querySelectorAll('#tablaUsuarios thead th');
        ths.forEach((th, idx) => {
            const up = th.querySelector('.sort-arrow-up');
            const down = th.querySelector('.sort-arrow-down');
            if (!up || !down) return;

            if (idx === activeColIndex) {
                if (direction === 'asc') {
                    up.className = 'sort-arrow-up text-primary fw-bold';
                    down.className = 'sort-arrow-down text-muted opacity-25';
                } else {
                    down.className = 'sort-arrow-down text-primary fw-bold';
                    up.className = 'sort-arrow-up text-muted opacity-25';
                }
            } else {
                up.className = 'sort-arrow-up text-muted';
                down.className = 'sort-arrow-down text-muted';
            }
        });
    }

    function confirmarEliminarUsuario(id, nombre, email, idNumber, role) {
        document.getElementById('delUserId').value = id;
        document.getElementById('delUserNombre').textContent = nombre;
        document.getElementById('delUserEmail').textContent = email;
        document.getElementById('delUserIdNumber').textContent = idNumber || 'No registrada';

        const roleBadge = document.getElementById('delUserRoleBadge');
        if (role === 'Admin') {
            roleBadge.className = 'badge bg-danger';
            roleBadge.textContent = 'Rol: Administrador';
        } else if (role === 'Creator') {
            roleBadge.className = 'badge bg-warning text-dark';
            roleBadge.textContent = 'Rol: Creador de Cursos';
        } else {
            roleBadge.className = 'badge bg-primary';
            roleBadge.textContent = 'Rol: Alumno / Estudiante';
        }

        const modalEl = document.getElementById('modalEliminarUsuario');
        const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
        modal.show();
    }
</script>
}

